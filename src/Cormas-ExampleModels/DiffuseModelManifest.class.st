Class {
	#name : 'DiffuseModelManifest',
	#superclass : 'CMModelManifest',
	#category : 'Cormas-ExampleModels',
	#package : 'Cormas-ExampleModels'
}

{ #category : 'parameters' }
DiffuseModelManifest class >> aboutThisModel [

	^ 'This is a simple model where ants move and deposit hormones. For more information, visit [our website](https://cormas.org).

## Agents

There are two types of entities:

1. Ants who deposite hormones on the ground while moving,
2. Cells in charge of diffusing and evaporating hormones
'
]

{ #category : 'parameters' }
DiffuseModelManifest class >> baselineName [

	^ 'Diffuse'
]

{ #category : 'parameters' }
DiffuseModelManifest class >> githubRepositoryName [

	^ 'diffuse-model'
]

{ #category : 'parameters' }
DiffuseModelManifest class >> modelName [

	^ 'Diffuse'
]

{ #category : 'parameters' }
DiffuseModelManifest class >> screenshotContents [
	"Screenshot of model's spatial grid provided as a string in Base 64 encoding"

	^ ''
]
